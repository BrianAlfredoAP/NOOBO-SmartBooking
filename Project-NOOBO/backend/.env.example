PORT=3000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=smartbooking_db

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_REFRESH_EXPIRES_IN=7d

# App
APP_URL=http://localhost:3000

# Pembina approval link (hours)
APPROVAL_TOKEN_TTL_HOURS=48

# Lokasi penyimpanan dokumen PDF (SBP/SBPG)
DOCUMENT_STORAGE_DIR=storage/documents

# Email outbox (SMTP). Leave MAIL_HOST empty to log emails locally instead of sending.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smartbooking.local
